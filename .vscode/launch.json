{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lunaci: Uygulamayı Çalıştır",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "Lunaci: Dış Terminalde Çalıştır",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "externalTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
